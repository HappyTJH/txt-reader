  "description": "A lightweight local-first TXT reader for Chinese and English books.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HappyTJH/txt-reader.git"
  },
  "bugs": {
    "url": "https://github.com/HappyTJH/txt-reader/issues"
  },
  "homepage": "https://happytjh.github.io/txt-reader/",
